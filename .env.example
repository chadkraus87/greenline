# Greenline v2 frontend config. Copy to `.env` and fill in from the Supabase
# project (Project Settings → API). These are the PUBLIC anon/publishable
# values — safe to ship in the browser. Never put the service-role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-publishable-or-anon-key
