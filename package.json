{
  "name": "greenline",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A private monthly budget tracker. Multi-user with admin approval; each account's data is isolated by Postgres row-level security.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/spline-sans-mono": "^5.3.0",
    "@supabase/supabase-js": "^2.111.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/ui": "^4.1.10",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "brace-expansion@2": "^2.1.4",
    "brace-expansion@5": "^5.0.9",
    "fast-uri": "^3.1.5",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.26",
    "undici": "^7.29.0"
  }
}
